@model Room

<h2>Delete Room</h2>

<h3>Are you sure you want to delete this room?</h3>

<div>
    <h4>Room</h4>
    <hr />

    <dl class="row">
        <dt class="col-sm-2">Room Id</dt>
        <dd class="col-sm-10">@Model.RoomId</dd>

        <dt class="col-sm-2">Room Name</dt>
        <dd class="col-sm-10">@Model.RoomName</dd>

        <dt class="col-sm-2">Capacity</dt>
        <dd class="col-sm-10">@Model.Capacity</dd>

        <dt class="col-sm-2">Building</dt>
        <dd class="col-sm-10">@Model.Building</dd>
    </dl>

    <!-- Deletes the selected room -->
    <form asp-action="DeleteConfirmed"
          asp-route-id="@Model.RoomId"
          method="post">

        <button type="submit" class="btn btn-danger">Delete</button>
        <a asp-action="Table" class="btn btn-secondary">Cancel</a>
    </form>
</div>