@model IEnumerable<StudyRoomBooking.Web.Models.Room>

<div class="container">
    <h1>@ViewBag.CurrentViewName</h1>
    <table class='table table-striped'>
        <tr><th>Id</th><th>RoomName</th><th>Capacity</th><th>Building</th></tr>
        @foreach (var room in Model)
        {
            <tr>
                <td>@room.RoomId</td>
                <td>@room.RoomName</td>
                <td>@room.Capacity</td>
                <td>@room.Building</td>
                <td></td>
            </tr>
        }
    </table>
</div>
